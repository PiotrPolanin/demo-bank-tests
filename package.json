{
  "name": "demo-bank-tests",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:login": "npx playwright test tests/login.spec.ts",
    "test:pulpit": "npx playwright test tests/pulpit.spec.ts",
    "test:pulpit:headed": "npx playwright test tests/pulpit.spec.ts -- --headed",
    "test:payment:desktop": "npx playwright test tests/pulpit.spec.ts",
    "test:payment:main": "npx playwright test tests/payment.spec.ts",
    "test:payment:main:repeat": "npx playwright test tests/payment.spec.ts --repeat-each=10 --reporter=list",
    "test:login:annotation": "npx playwright test --grep \"@login\"",
    "test:payment:annotation": "npx playwright test --grep \"@payment\""
  },
